---
import sampleHtml from '../../../templates/blog/sample/index.html?raw';
import { client, formatDate, escapeHtml, cached, mapBlog, type Blog } from '../../lib/microcms';

const { id } = Astro.params;

if (id === 'sample') {
  return new Response(sampleHtml, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}

let blog: Blog;
try {
  const raw = await client.get<any>({ endpoint: 'blogs', contentId: id as string });
  blog = mapBlog(raw);
} catch {
  return Astro.redirect('/blog/');
}

// Fetch 5 recent articles for おすすめ記事 section
const recentBlogs = await cached<Blog[]>('blogs-list', async () => {
  const res = await client.getList<any>({
    endpoint: 'blogs',
    queries: { limit: 100, orders: '-publishedAt', fields: 'id,title,day,publishedAt,eyecatch,category' },
  });
  return res.contents.map(mapBlog);
}).catch(() => [] as Blog[]);

const relatedBlogs = recentBlogs.filter(b => b.id !== id).slice(0, 5);

let html = sampleHtml;

const date = formatDate(blog.day ?? blog.publishedAt);
const cat = typeof blog.category === 'string' ? blog.category : blog.category?.name ?? '';
const eyecatchUrl = blog.eyecatch?.url;

html = html.replace('>第3階層ページ<', '>' + escapeHtml(blog.title) + '<');
html = html.replace('>0000.00.00<', '>' + date + '<');
html = html.replace(/(<h1[^>]*>).*?(<\/h1>)/s, '$1' + escapeHtml(blog.title) + '$2');
if (cat) html = html.replaceAll('>ダミーカテゴリ<', '>' + escapeHtml(cat) + '<');

// Replace ALL blog-01.jpg placeholder occurrences (src and srcset) with eyecatch
if (eyecatchUrl) {
  html = html.replaceAll('/images/blog-01.jpg', eyecatchUrl);
}

// --- Strip WIX-scraped metadata from body HTML ---
function cleanWixContent(body: string): string {
  // Remove the first <h1> (duplicate article title)
  body = body.replace(/<h1[^>]*>[\s\S]*?<\/h1>/, '');

  // Remove elements containing Japanese date (e.g. 2025年10月27日)
  body = body.replace(/<(?:p|li|div|span)[^>]*>[^<]*\d{4}年\d{1,2}月\d{1,2}日[^<]*<\/(?:p|li|div|span)>/g, '');

  // Remove 読了時間 line
  body = body.replace(/<[^>]+>[^<]*読了時間[^<]*<\/[^>]+>/g, '');

  // Remove 閲覧数 element (label + possible sibling number)
  body = body.replace(/<[^>]+>[^<]*閲覧数[^<]*<\/[^>]+>/g, '');

  // Remove コメント element
  body = body.replace(/<[^>]+>[^<]*件のコメント[^<]*<\/[^>]+>/g, '');

  // Remove いいね！ element
  body = body.replace(/<[^>]+>[^<]*いいね！[^<]*<\/[^>]+>/g, '');

  // Remove 更新日 line
  body = body.replace(/<[^>]+>[^<]*更新日[：:][^<]*<\/[^>]+>/g, '');

  // Remove standalone numeric elements (view count, like count numbers like 551, 0)
  body = body.replace(/<(?:p|li|div|span)[^>]*>\s*\d{1,7}\s*<\/(?:p|li|div|span)>/g, '');

  // Clean up empty <ul> / <ol> left over
  body = body.replace(/<(?:ul|ol)[^>]*>\s*<\/(?:ul|ol)>/g, '');

  return body;
}

// --- CSS for article body, headings, and TOC ---
const articleCss = `<style>
html { scroll-behavior: smooth; }
.cms-body {
  font-size: 15px;
  line-height: 1.85;
  color: #333;
}
/* ── TOC Box ── */
.toc-box {
  background: #F0F9FF;
  border: 1px solid #BAE6FD;
  border-radius: 10px;
  padding: 20px 24px 20px 36px;
  margin: 0 0 2.2em;
  display: inline-block;
  min-width: 220px;
  max-width: 100%;
}
.toc-box li {
  margin-bottom: 8px;
  color: #1a1a1a;
  list-style: disc;
  padding-left: 0;
  position: static;
}
.toc-box li::before { content: none; }
.toc-box a {
  color: #2563EB !important;
  text-decoration: none !important;
  font-size: 14px;
  line-height: 1.6;
}
.toc-box a:hover {
  text-decoration: underline !important;
  opacity: 1 !important;
}
.toc-box .toc-box {
  margin: 6px 0 0;
  padding: 0 0 0 20px;
  border: none;
  background: transparent;
  border-radius: 0;
}
/* ── Headings ── */
.cms-body h2 {
  background: #EFF6FF;
  padding: 11px 18px 11px 14px;
  border-left: 5px solid #60A5FA;
  border-radius: 0 6px 6px 0;
  font-size: 24px;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.4;
  margin: 2.4em 0 1em;
  scroll-margin-top: 100px;
}
.cms-body h3 {
  border-top: 3px solid #60A5FA;
  border-bottom: 1px solid #BFDBFE;
  padding: 10px 4px;
  font-size: 20px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.5;
  margin: 2em 0 1em;
  scroll-margin-top: 100px;
}
.cms-body h4 {
  font-size: 17px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 1.6em 0 0.6em;
  scroll-margin-top: 100px;
}
/* ── Body text ── */
.cms-body p { margin-bottom: 1em; }
.cms-body ol { margin: 1em 0; padding-left: 2em; }
.cms-body ol li { margin-bottom: 0.5em; line-height: 1.75; }
.cms-body ul { margin: 1em 0; padding-left: 0.4em; }
.cms-body ul > li { list-style: none; padding-left: 1.5em; position: relative; margin-bottom: 0.6em; line-height: 1.75; }
.cms-body ul > li::before { content: "▶"; color: #60A5FA; position: absolute; left: 0; font-size: 0.68em; top: 0.42em; }
.cms-body a { color: #2563EB; text-decoration: underline; }
.cms-body a:hover { opacity: 0.75; }
.cms-body img { max-width: 100%; height: auto; margin: 1em 0; border-radius: 8px; }
.cms-body figure { margin: 2em 0; text-align: center; }
.cms-body figure img { margin: 0; box-shadow: 0 4px 16px rgba(0,0,0,0.10); border-radius: 12px; }
.cms-body figcaption { margin-top: 8px; font-size: 13px; color: #6B7280; }
.cms-body table { border-collapse: collapse; width: 100%; margin: 1.5em 0; table-layout: auto; }
.cms-body th { background: #DBEAFE; color: #1E40AF; font-weight: 700; text-align: center; padding: 10px 14px; border: 1px solid #93C5FD; white-space: nowrap; }
.cms-body td { border: 1px solid #DBEAFE; padding: 9px 13px; text-align: center; vertical-align: middle; }
.cms-body blockquote { border-left: 4px solid #93C5FD; background: #F0F9FF; margin: 1.5em 0; padding: 12px 16px; color: #374151; border-radius: 0 6px 6px 0; }
</style>`;

// --- JS: detect TOC, fix anchor IDs, color-code tip/warning blockquotes ---
const tocJs = `<script>
(function() {
  var body = document.querySelector('.cms-body');
  if (!body) return;
  // Find first list containing anchor links → TOC
  var lists = body.querySelectorAll('ol, ul');
  var toc = null;
  for (var i = 0; i < lists.length; i++) {
    if (lists[i].querySelector('a[href^="#"]')) { toc = lists[i]; break; }
  }
  if (!toc) return;
  toc.classList.add('toc-box');
  // Fix heading IDs to match TOC links
  var links = toc.querySelectorAll('a[href^="#"]');
  var headings = Array.from(body.querySelectorAll('h2, h3, h4')).filter(function(h) {
    return !toc.contains(h);
  });
  var hi = 0;
  links.forEach(function(link) {
    var anchor = link.getAttribute('href').slice(1);
    if (!document.getElementById(anchor) && hi < headings.length) {
      headings[hi].id = anchor;
    }
    hi++;
  });
  // Color-code blockquotes by emoji prefix
  body.querySelectorAll('blockquote').forEach(function(bq) {
    var text = bq.textContent || '';
    if (text.indexOf('🌙') !== -1) {
      // Dark CTA card
      bq.style.background = '#1F2937';
      bq.style.border = 'none';
      bq.style.borderRadius = '10px';
      bq.style.padding = '28px 24px';
      bq.style.margin = '32px 0';
      bq.style.textAlign = 'center';
      bq.querySelectorAll('p').forEach(function(p) { p.style.color = '#F9FAFB'; });
      bq.querySelectorAll('small').forEach(function(s) { s.style.color = '#9CA3AF'; s.style.fontSize = '13px'; });
      bq.querySelectorAll('a').forEach(function(a, i) {
        a.style.display = 'inline-block';
        a.style.padding = '12px 26px';
        a.style.borderRadius = '6px';
        a.style.textDecoration = 'none';
        a.style.fontWeight = 'bold';
        a.style.margin = '6px 4px';
        a.style.fontSize = '14px';
        if (i === 0) { a.style.background = '#3B82F6'; a.style.color = '#fff'; }
        else { a.style.background = '#22C55E'; a.style.color = '#fff'; }
      });
    } else if (text.indexOf('🚫') !== -1) {
      bq.style.borderLeftColor = '#FCA5A5';
      bq.style.background = '#FEF2F2';
    } else if (text.indexOf('💡') !== -1) {
      bq.style.borderLeftColor = '#60A5FA';
      bq.style.background = '#EFF6FF';
    } else if (text.indexOf('⚠️') !== -1) {
      bq.style.borderLeftColor = '#FBBF24';
      bq.style.background = '#FFFBEB';
    }
  });
})();
</script>`;

const bodyHtml = blog.body ?? blog.content ?? '';
if (bodyHtml) {
  const cleanedBody = cleanWixContent(bodyHtml);
  const BODY_START = '<div class="pt-20 flex flex-col gap-20">';
  const BODY_END   = '</div></article>';
  const si = html.indexOf(BODY_START);
  const ei = html.indexOf(BODY_END, si);
  if (si !== -1 && ei !== -1) {
    html = html.slice(0, si) + BODY_START + '<div class="cms-body">' + cleanedBody + '</div>' + BODY_END + html.slice(ei + BODY_END.length);
  }
}

// --- Replace おすすめ記事 section with recent articles ---
if (relatedBlogs.length > 0) {
  const RECO_START = '<div class="flex gap-6 overflow-x-auto pb-4">';
  const RECO_END   = '</div></div></section>';
  const ri = html.indexOf(RECO_START);
  if (ri !== -1) {
    const re = html.indexOf(RECO_END, ri);
    if (re !== -1) {
      const cards = relatedBlogs.map(b => {
        const bDate = formatDate(b.day ?? b.publishedAt);
        const bCat  = typeof b.category === 'string' ? b.category : b.category?.name ?? '';
        const bImg  = b.eyecatch?.url ?? '/images/blog-01.jpg';
        return (
          '<a class="shrink-0 w-[220px] flex flex-col gap-2 hover:opacity-70 transition-opacity" href="/blog/' + b.id + '/">' +
          '<div class="w-full aspect-[384/200] relative rounded-[10px] overflow-hidden">' +
          '<img alt="' + escapeHtml(b.title) + '" loading="lazy" class="object-cover" src="' + bImg + '" style="position:absolute;height:100%;width:100%;inset:0;object-fit:cover;"></div>' +
          '<div class="flex items-start gap-2">' +
          '<span class="text-base font-black font-en leading-[1.5] text-black shrink-0">' + bDate + '</span>' +
          (bCat ? '<span class="text-xs text-[#005bea] border border-[#005bea] rounded-[10px] px-4 py-[2px] leading-[1.4] whitespace-nowrap">' + escapeHtml(bCat) + '</span>' : '') +
          '</div>' +
          '<p class="text-lg font-semibold text-[#005bea] leading-[1.7] line-clamp-2">' + escapeHtml(b.title) + '</p>' +
          '</a>'
        );
      }).join('');
      html = html.slice(0, ri) + RECO_START + cards + RECO_END + html.slice(re + RECO_END.length);
    }
  }
}

html = html.replace(/<title>.*?<\/title>/, '<title>' + escapeHtml(blog.title) + ' | COCOマーケ</title>');
html = html.replace('/blog/sample/', '/blog/' + (id ?? '') + '/');

const pageUrl = 'https://www.cocomarke.com/blog/' + (id ?? '') + '/';
const ogImage = eyecatchUrl ?? 'https://www.cocomarke.com/images/header-logo.png';
const ogDesc = escapeHtml((blog.body ?? blog.content ?? '').replace(/<[^>]+>/g, '').slice(0, 120));

// Remove template's generic OG/Twitter tags to prevent duplicates
html = html.replace(/<meta property="og:[^"]*"[^>]*>/g, '');
html = html.replace(/<meta name="twitter:[^"]*"[^>]*>/g, '');
// Replace generic meta description with article-specific
html = html.replace(/<meta name="description" content="[^"]*">/, '<meta name="description" content="' + ogDesc + '">');

const canonical = '<link rel="canonical" href="' + pageUrl + '">';
const ogTags = [
  '<meta property="og:type" content="article">',
  '<meta property="og:url" content="' + pageUrl + '">',
  '<meta property="og:title" content="' + escapeHtml(blog.title) + ' | COCOマーケ">',
  '<meta property="og:description" content="' + ogDesc + '">',
  '<meta property="og:image" content="' + ogImage + '">',
  '<meta property="og:site_name" content="COCOマーケ">',
  '<meta property="og:locale" content="ja_JP">',
  '<meta name="twitter:card" content="summary_large_image">',
  '<meta name="twitter:title" content="' + escapeHtml(blog.title) + ' | COCOマーケ">',
  '<meta name="twitter:description" content="' + ogDesc + '">',
  '<meta name="twitter:image" content="' + ogImage + '">',
].join('');
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: blog.title,
  image: ogImage,
  datePublished: (blog.day ?? blog.publishedAt ?? '').slice(0, 10),
  author: { '@type': 'Organization', name: 'COCOマーケ', url: 'https://www.cocomarke.com/' },
  publisher: {
    '@type': 'Organization',
    name: 'COCOマーケ',
    logo: { '@type': 'ImageObject', url: 'https://www.cocomarke.com/images/header-logo.png' },
  },
  url: pageUrl,
  description: ogDesc,
});
const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.cocomarke.com/' },
    { '@type': 'ListItem', position: 2, name: 'お役立ち情報', item: 'https://www.cocomarke.com/blog/' },
    { '@type': 'ListItem', position: 3, name: blog.title, item: pageUrl },
  ],
});
const schemaScripts = `<script type="application/ld+json">${articleSchema}</script><script type="application/ld+json">${breadcrumbSchema}</script>`;
html = html.replace('</head>', canonical + ogTags + schemaScripts + articleCss + '</head>');
html = html.replace('</body>', tocJs + '</body>');

return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
---

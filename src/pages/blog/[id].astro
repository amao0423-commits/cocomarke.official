  .cms-body .cm-table-wrap > table { min-width: 560px; }
  .cms-body th, .cms-body td { padding: 8px 10px; font-size: 14px; }
}
.cms-body blockquote { border-left: 4px solid #93C5FD; background: #F0F9FF; margin: 1.5em 0; padding: 12px 16px; color: #374151; border-radius: 0 6px 6px 0; }
</style>`;

// --- JS: detect TOC, fix anchor IDs, color-code tip/warning blockquotes ---
const tocJs = `<script>
(function() {
  var body = document.querySelector('.cms-body');
  if (!body) return;
  // Find first list containing anchor links → TOC
  var lists = body.querySelectorAll('ol, ul');
  var toc = null;
  for (var i = 0; i < lists.length; i++) {
    if (lists[i].querySelector('a[href^="#"]')) { toc = lists[i]; break; }
  }
  if (!toc) return;
  toc.classList.add('toc-box');
  // Map each TOC link to its heading. microCMS overrides heading ids with
  // its own hashes, so the original #h-sN / named anchors don't resolve.
  // Re-point each link to the live heading id using, in order of priority:
  //   1. exact text match  2. prefix match  3. positional fallback.
  // A moving pointer keeps links in document order, so descriptive TOCs
  // (link text differs from the heading) still map correctly, while the
  // わかること/目次 headings are excluded so the index never shifts.
  var norm = function(s) { return (s || '').replace(/\s+/g, '').trim(); };
  var links = toc.querySelectorAll('a[href^="#"]');
  var cands = Array.from(body.querySelectorAll('h2, h3, h4')).filter(function(h) {
    if (toc.contains(h)) return false;
    var t = norm(h.textContent);
    return t !== 'この記事でわかること' && t !== '目次';
  }).map(function(h) { return { el: h, text: norm(h.textContent), used: false }; });
  var ptr = 0;
  links.forEach(function(link) {
    var lt = norm(link.textContent);
    var target = null, ti = -1;
    // 1. exact text match (first unused)
    for (var k = 0; k < cands.length; k++) {
      if (!cands[k].used && cands[k].text === lt) { target = cands[k]; ti = k; break; }
    }
    // 2. prefix match (heading truncated/suffixed vs link), min length guard
    if (!target && lt.length >= 6) {
      for (var k2 = 0; k2 < cands.length; k2++) {
        var ct = cands[k2].text;
        if (!cands[k2].used && (ct.indexOf(lt) === 0 || lt.indexOf(ct) === 0)) {
          target = cands[k2]; ti = k2; break;
        }
      }
    }
    // 3. positional: next unused H2 at/after the pointer
    if (!target) {
      for (var k3 = ptr; k3 < cands.length; k3++) {
        if (!cands[k3].used && cands[k3].el.tagName === 'H2') { target = cands[k3]; ti = k3; break; }
      }
    }
    if (target) {
      target.used = true;
      ptr = ti + 1;
      if (!target.el.id) target.el.id = link.getAttribute('href').slice(1);
      link.setAttribute('href', '#' + target.el.id);
    }
  });
  // Color-code blockquotes by emoji prefix
  body.querySelectorAll('blockquote').forEach(function(bq) {
    var text = bq.textContent || '';
    if (bq.querySelector('a[href*="cocomarke.com/contact"]')) {
      // Dark CTA card (detected by contact link)
      bq.style.background = '#1F2937';
      bq.style.border = 'none';
      bq.style.borderRadius = '10px';
      bq.style.padding = '28px 24px';
      bq.style.margin = '32px 0';
      bq.style.textAlign = 'center';
      bq.querySelectorAll('p').forEach(function(p) { p.style.color = '#F9FAFB'; });
      bq.querySelectorAll('small').forEach(function(s) { s.style.color = '#9CA3AF'; s.style.fontSize = '13px'; });
      bq.querySelectorAll('a').forEach(function(a, i) {
        a.style.display = 'inline-block';
        a.style.padding = '12px 26px';
        a.style.borderRadius = '6px';
        a.style.textDecoration = 'none';
        a.style.fontWeight = 'bold';
        a.style.margin = '6px 4px';
        a.style.fontSize = '14px';
        if (i === 0) { a.style.background = '#3B82F6'; a.style.color = '#fff'; }
        else { a.style.background = '#22C55E'; a.style.color = '#fff'; }
      });
    } else if (text.indexOf('🚫') !== -1) {
      bq.style.borderLeftColor = '#FCA5A5';
      bq.style.background = '#FEF2F2';
    } else if (text.indexOf('💡') !== -1) {
      bq.style.borderLeftColor = '#60A5FA';
      bq.style.background = '#EFF6FF';
    } else if (text.indexOf('⚠️') !== -1) {
      bq.style.borderLeftColor = '#FBBF24';
      bq.style.background = '#FFFBEB';
    }
  });
})();
</script>`;

// --- Lead block (override articles only) ---
const leadHtml = override?.lead
  ? `<div style="background:#EFF6FF;border-left:5px solid #3B82F6;padding:16px 20px;margin:0 0 28px;border-radius:0 8px 8px 0;"><p style="margin:0;font-size:15px;line-height:1.8;color:#1E3A5F;">${escapeHtml(override.lead)}</p></div>`
  : '';

// --- Override FAQ block（セクション間隔はコンテナの gap-20 に統一） ---
const overrideFaqHtml = override?.faqs?.length
  ? `<div class="cms-body" id="seo-faq"><h2 id="h-faq">よくある質問</h2>` +
    override.faqs.map((f, i) =>
      `<h3>Q${i + 1}. ${escapeHtml(f.q)}</h3><p>${escapeHtml(f.a)}</p>`
    ).join('') +
    `</div>`
  : '';

const bodyHtml = blog.body ?? blog.content ?? '';
if (bodyHtml) {
  let cleanedBody = cleanWixContent(bodyHtml);
  // 表をモバイルで横スクロール可能に（microCMSがinline styleを除去するためフロント側でラップ）
  cleanedBody = cleanedBody.replace(/<table/g, '<div class="cm-table-wrap"><table').replace(/<\/table>/g, '</table></div>');
  // 本文のmicroCMS画像をWebP化＋幅制限（表示は最大720px幅・retina考慮で880px、非拡大）
  cleanedBody = cleanedBody.replace(/(<img[^>]+src=")(https:\/\/images\.microcms-assets\.io\/[^"?]+)"/g, '$1$2?fm=webp&w=880&q=78&fit=max"');
  // 2つ目の本文段落末にミニCTA（離脱前接触）
  if (island) cleanedBody = injectMiniCta(cleanedBody, island, id ?? '');
  // override.faqs が指定されているときだけ本文FAQをストリップして差し替える
  if (override?.faqs?.length) {
    cleanedBody = cleanedBody.replace(/<h2[^>]*>[^<]*よくある質問[^<]*<\/h2>[\s\S]*/gi, '');
  }
  const BODY_START = '<div class="pt-20 flex flex-col gap-20">';
  const BODY_END   = '</div></article>';
  const si = html.indexOf(BODY_START);
  const ei = html.indexOf(BODY_END, si);
  if (si !== -1 && ei !== -1) {
    html = html.slice(0, si) + BODY_START +
      leadHtml +
      '<div class="cms-body">' + cleanedBody + '</div>' +
      overrideFaqHtml +
      (island ? articleEndCta(island, id ?? '') : '') +
      authorBox() +
      mobileArticleBanners() +
      BODY_END + html.slice(ei + BODY_END.length);
  }
}

// --- Replace おすすめ記事 section with recent articles ---
if (relatedBlogs.length > 0) {
  const RECO_START = '<div class="flex gap-6 overflow-x-auto pb-4">';
  const RECO_END   = '</div></div></section>';
  const ri = html.indexOf(RECO_START);
  if (ri !== -1) {
    const re = html.indexOf(RECO_END, ri);
    if (re !== -1) {
      const cards = relatedBlogs.map(b => {
        const bDate = formatDate(b.day ?? b.publishedAt);
        const bCat  = typeof b.category === 'string' ? b.category : b.category?.name ?? '';
        const bImg  = b.eyecatch?.url ?? '/images/blog-01.jpg';
        return (
          '<a class="shrink-0 w-[220px] flex flex-col gap-2 hover:opacity-70 transition-opacity" href="/blog/' + b.id + '/">' +
          '<div class="w-full aspect-[384/200] relative rounded-[10px] overflow-hidden">' +
          '<img alt="' + escapeHtml(b.title) + '" loading="lazy" class="object-cover" src="' + bImg + '" style="position:absolute;height:100%;width:100%;inset:0;object-fit:cover;"></div>' +
          '<div class="flex items-start gap-2">' +
          '<span class="text-base font-black font-en leading-[1.5] text-black shrink-0">' + bDate + '</span>' +
          (bCat ? '<span class="text-xs text-[#005bea] border border-[#005bea] rounded-[10px] px-4 py-[2px] leading-[1.4] whitespace-nowrap">' + escapeHtml(bCat) + '</span>' : '') +
          '</div>' +
          '<p class="text-lg font-semibold text-[#005bea] leading-[1.7] line-clamp-2">' + escapeHtml(b.title) + '</p>' +
          '</a>'
        );
      }).join('');
      html = html.slice(0, ri) + RECO_START + cards + RECO_END + html.slice(re + RECO_END.length);
    }
  }
}

const displayTitle = override?.title ?? blog.title;
const displayDesc  = override?.description ?? (blog.body ?? blog.content ?? '').replace(/<[^>]+>/g, '').slice(0, 120);

html = html.replace(/<title>.*?<\/title>/, '<title>' + escapeHtml(displayTitle) + ' | COCOマーケ</title>');
html = html.replace('/blog/sample/', '/blog/' + (id ?? '') + '/');

const pageUrl = 'https://www.cocomarke.com/blog/' + (id ?? '') + '/';
const ogImage = eyecatchUrl ?? 'https://www.cocomarke.com/images/header-logo.png';
const ogDesc = escapeHtml(displayDesc);

// Remove template's generic OG/Twitter tags to prevent duplicates
html = html.replace(/<meta property="og:[^"]*"[^>]*>/g, '');
html = html.replace(/<meta name="twitter:[^"]*"[^>]*>/g, '');
// Replace generic meta description with article-specific
html = html.replace(/<meta name="description" content="[^"]*">/, '<meta name="description" content="' + ogDesc + '">');

const canonical = '<link rel="canonical" href="' + pageUrl + '">';
const ogTags = [
  '<meta property="og:type" content="article">',
  '<meta property="og:url" content="' + pageUrl + '">',
  '<meta property="og:title" content="' + escapeHtml(displayTitle) + ' | COCOマーケ">',
  '<meta property="og:description" content="' + ogDesc + '">',
  '<meta property="og:image" content="' + ogImage + '">',
  '<meta property="og:site_name" content="COCOマーケ">',
  '<meta property="og:locale" content="ja_JP">',
  '<meta name="twitter:card" content="summary_large_image">',
  '<meta name="twitter:title" content="' + escapeHtml(displayTitle) + ' | COCOマーケ">',
  '<meta name="twitter:description" content="' + ogDesc + '">',
  '<meta name="twitter:image" content="' + ogImage + '">',
].join('');
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  headline: displayTitle,
  image: [{
    '@type': 'ImageObject',
    url: eyecatchUrl ?? 'https://www.cocomarke.com/images/header-logo.png',
    width: blog.eyecatch?.width ?? 1200,
    height: blog.eyecatch?.height ?? 630,
  }],
  datePublished: (blog.day ?? blog.publishedAt ?? '').slice(0, 10),
  dateModified: (blog.updatedAt ?? blog.day ?? blog.publishedAt ?? '').slice(0, 10),
  author: { '@type': 'Organization', name: 'COCOマーケ', url: 'https://www.cocomarke.com/' },
  publisher: {
    '@type': 'Organization',
    name: 'COCOマーケ',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.cocomarke.com/images/header-logo.png',
      width: 400,
      height: 80,
    },
  },
  description: ogDesc,
});
const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.cocomarke.com/' },
    { '@type': 'ListItem', position: 2, name: 'お役立ち情報', item: 'https://www.cocomarke.com/blog/' },
    { '@type': 'ListItem', position: 3, name: blog.title, item: pageUrl },
  ],
});
// FAQPage schema: override 記事は手動マップを使用。それ以外は本文「よくある質問」を自動パースして生成。
// 本文FAQ(microCMS content)構造: <h2>よくある質問</h2> に続く <p><strong>Q…</strong></p><p>回答</p> の繰り返し。
function stripFaqTags(s) {
  return s.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();
}
function extractBodyFaqs(htmlStr) {
  if (!htmlStr) return [];
  const sec = htmlStr.match(/<h2[^>]*>[^<]*よくある質問[^<]*<\/h2>([\s\S]*?)(?=<h2|$)/i);
  if (!sec) return [];
  const faqs = [];
  const re = /<p>\s*<strong>([\s\S]*?)<\/strong>\s*<\/p>\s*<p>([\s\S]*?)<\/p>/gi;
  let m;
  while ((m = re.exec(sec[1])) !== null) {
    const q = stripFaqTags(m[1]).replace(/^Q\s*[.．:：]?\s*/i, '').trim();
    const a = stripFaqTags(m[2]).trim();
    if (q && a) faqs.push({ q, a });
  }
  return faqs;
}
const faqForSchema = override?.faqs?.length
  ? override.faqs
  : extractBodyFaqs(blog.body ?? blog.content ?? '');
const faqPageSchema = faqForSchema.length ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqForSchema.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}) : null;

const schemaScripts = [
  `<script type="application/ld+json">${articleSchema}</script>`,
  `<script type="application/ld+json">${breadcrumbSchema}</script>`,
  faqPageSchema ? `<script type="application/ld+json">${faqPageSchema}</script>` : '',
].join('');

// GA4 event tracking
const ga4Js = `<script>(function(){
document.addEventListener('click',function(e){
  var t=e.target.closest('a');
  if(!t||typeof gtag==='undefined')return;
  var h=t.href||'';
  var ev=null;
  if(h.indexOf('cocomarke.com/contact')!==-1)ev='contact_click';
  else if(h.indexOf('cocomake-guide.com')!==-1)ev='document_click';
  else if(h.indexOf('line.me')!==-1||h.indexOf('lin.ee')!==-1)ev='line_click';
  else if(t.closest('#seo-related'))ev='related_article_click';
  else if(t.closest('blockquote')&&h.indexOf('cocomarke.com')!==-1)ev='article_cta_click';
  if(ev)gtag('event',ev,{page_slug:window.location.pathname,link_url:h});
});
})();</script>`;

html = html.replace(/<link rel="canonical"[^>]*>/i, '');
html = html.replace('</head>', canonical + ogTags + schemaScripts + articleCss + SIDEBAR_STYLE + ARTICLE_CTA_CSS + '</head>');
html = html.replace('</body>', tocJs + ga4Js + '</body>');

// 記事内の cocomake-guide リンク（バナー・本文CTA）に流入分析用UTMを付与
html = html.replaceAll(
  'href="https://www.cocomake-guide.com/analysis"',
  'href="https://www.cocomake-guide.com/analysis?utm_source=cocomarke&utm_medium=blog_sidebar&utm_campaign=blog&utm_content=banner_diagnosis"'
);
html = html.replaceAll(
  'href="https://www.cocomake-guide.com/servicedocument"',
  'href="https://www.cocomake-guide.com/servicedocument?utm_source=cocomarke&utm_medium=blog_sidebar&utm_campaign=blog&utm_content=banner_document"'
);

// 既存の右サイドバー（aside＋バナー2枚）を新サイドバー（診断CTA→最新記事→検索）に差し替え
const ASIDE_OPEN = '<aside class="hidden lg:flex flex-col gap-10 w-[280px] shrink-0 pt-[120px]">';
const asideStart = html.indexOf(ASIDE_OPEN);
if (asideStart !== -1) {
  const asideEnd = html.indexOf('</aside>', asideStart);
  if (asideEnd !== -1) {
    html = html.slice(0, asideStart) + articleSidebar(latestItems) + html.slice(asideEnd + '</aside>'.length);
  }
}

html = injectGtm(html);

return new Response(html, {
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    'Cache-Control': 'public, max-age=0, s-maxage=600, stale-while-revalidate=86400',
  },
});

---
import sampleHtml from '../../../templates/blog/sample/index.html?raw';
import { client, formatDate, escapeHtml, cached, mapBlog, type Blog } from '../../lib/microcms';
import { SEO_OVERRIDES } from '../../lib/blogSeoOverrides';
import { injectGtm } from '../../lib/gtm';
import { articleSidebar, mobileArticleBanners, SIDEBAR_STYLE, type LatestItem } from '../../lib/blogSidebar';
import { getIsland, articleEndCta, injectMiniCta, ARTICLE_CTA_CSS, ISLAND_RELATED, subTags, subTagLabels, authorBox } from '../../lib/articleCta';
import { catName } from '../../lib/blogList';

const { id } = Astro.params;

if (id === 'sample') {
  return new Response(injectGtm(sampleHtml), { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}

// 記事取得と関連記事取得を並列実行
const [rawBlog, recentBlogs] = await Promise.all([
  client.get<any>({ endpoint: 'blogs', contentId: id as string }).catch(() => null),
  cached<Blog[]>('blogs-related-100', async () => {
    const res = await client.getList<any>({
      endpoint: 'blogs',
      queries: { limit: 100, orders: '-publishedAt', fields: 'id,title,day,publishedAt,eyecatch,category' },
    });
    return res.contents.map(mapBlog);
  }).catch(() => [] as Blog[]),
]);

if (!rawBlog) return Astro.redirect('/blog/');
const blog = mapBlog(rawBlog);

// 右サイドバー「最新記事」用：新着3件（現記事は除外）
const latestItems: LatestItem[] = recentBlogs
  .filter(b => b.id !== id)
  .slice(0, 3)
  .map(b => ({
    id: b.id,
    title: b.title,
    category: catName(b),
    img: b.eyecatch?.url ?? '/images/blog-01.jpg',
  }));

// この記事が属する島（タスク①のslug→islandマップを流用）
const island = getIsland(id);

// おすすめ記事：記事内容に合わせた関連度でスコアリング（最大5件・現記事は除外）
//   サブタグ（テーマ）の一致を主軸に、同じ島・同カテゴリーを加点。足りなければ新着で補完。
const curCat = typeof blog.category === 'string' ? blog.category : blog.category?.name ?? '';
const catOf = (b: Blog) => (typeof b.category === 'string' ? b.category : b.category?.name ?? '');
const curTags = subTagLabels(blog.title, id ?? '');
const islandSet = island ? new Set(ISLAND_RELATED[island]) : null;

const scored = recentBlogs
  .filter(b => b.id !== id)
  .map(b => {
    const overlap = subTagLabels(b.title, b.id).filter(t => curTags.includes(t)).length;
    let score = overlap * 3;
    if (islandSet?.has(b.id)) score += 4;       // 同じ島の代表記事を優遇
    if (curCat && catOf(b) === curCat) score += 1; // 同カテゴリーを微加点
    return { b, score };
  })
  .sort((a, b) => b.score - a.score); // 同点は新着順（recentBlogsが-publishedAt）

const relatedBlogs = [
  ...scored.filter(s => s.score > 0).map(s => s.b),
  ...scored.filter(s => s.score === 0).map(s => s.b), // 関連が薄い場合は新着で補完
].slice(0, 5);

// SEO overrides for specific articles
const override = SEO_OVERRIDES[id ?? ''];

let html = sampleHtml;

const date = formatDate(blog.day ?? blog.publishedAt);
const cat = typeof blog.category === 'string' ? blog.category : blog.category?.name ?? '';
const eyecatchUrl = blog.eyecatch?.url;
// microCMS(imgix)画像を表示用に最適化（WebP変換・幅制限・非拡大）。OG/schemaは生URLのまま使う。
const mcImg = (u: string | undefined, w: number, q = 78): string | undefined =>
  u ? `${u}${u.includes('?') ? '&' : '?'}fm=webp&w=${w}&q=${q}&fit=max` : u;
const eyecatchImg = mcImg(eyecatchUrl, 960);

html = html.replace(
  '<ol class="flex items-center gap-2 text-xs text-[#333] leading-[1.4]">',
  '<ol class="flex items-center gap-2 text-xs text-[#333] leading-[1.4] overflow-hidden">'
);
html = html.replace(
  '<li><a class="font-medium hover:opacity-70 transition-opacity" href="/">トップページ</a></li>',
  '<li class="whitespace-nowrap shrink-0"><a class="font-medium hover:opacity-70 transition-opacity" href="/">トップページ</a></li>'
);
html = html.replace(
  '<li><a class="font-medium hover:opacity-70 transition-opacity" href="/blog/">お役立ち情報</a></li>',
  '<li class="whitespace-nowrap shrink-0"><a class="font-medium hover:opacity-70 transition-opacity" href="/blog/">お役立ち情報</a></li>'
);
html = html.replace('>第3階層ページ<', ' class="min-w-0 truncate">' + escapeHtml(blog.title) + '<');
html = html.replace(
  '</head>',
  '<link rel="preconnect" href="https://images.microcms-assets.io" crossorigin>' +
  (eyecatchImg ? `<link rel="preload" as="image" href="${eyecatchImg}" fetchpriority="high">` : '') +
  '<style>nav ol>li.shrink-0+li{flex-shrink:0}</style></head>'
);
html = html.replace('>0000.00.00<', '>' + date + '<');
// 更新日表示：投稿日と日付（日単位）が異なる場合のみ「更新日：」を追加表示する
// （リライト等で本当に更新した記事だけに表示し、未更新記事には表示しない）
const updatedSource = blog.updatedAt;
if (updatedSource) {
  const updatedDate = formatDate(updatedSource);
  if (updatedDate !== date) {
    html = html.replace(
      '<!--UPDATED_DATE_SLOT-->',
      `<time class="text-sm font-bold font-en leading-[1.6] text-[#666] ml-2">更新日：${updatedDate}</time>`
    );
  } else {
    html = html.replace('<!--UPDATED_DATE_SLOT-->', '');
  }
} else {
  html = html.replace('<!--UPDATED_DATE_SLOT-->', '');
}
html = html.replace(/(<h1[^>]*>).*?(<\/h1>)/s, '$1' + escapeHtml(blog.title) + '$2' + subTags(blog.title, id ?? ''));
if (cat) html = html.replaceAll('>ダミーカテゴリ<', '>' + escapeHtml(cat) + '<');

// Replace ALL blog-01.jpg placeholder occurrences (src and srcset) with eyecatch
if (eyecatchImg) {
  html = html.replaceAll('/images/blog-01.jpg', eyecatchImg);
}

// --- Strip WIX-scraped metadata from body HTML ---
// ※ 要素の「先頭」がメタ情報のときだけ削除する（本文中に同じ語が出ても壊さない）。
//   対象タグは p/li/div/span に限定し、</a> 等の閉じタグを開始タグと誤認しない。
function cleanWixContent(body: string): string {
  const E = '(?:p|li|div|span)';
  // Remove the first <h1> (duplicate article title)
  body = body.replace(/<h1[^>]*>[\s\S]*?<\/h1>/, '');

  // 先頭が日付だけの行（例: 2025年10月27日）
  body = body.replace(new RegExp(`<${E}[^>]*>\\s*\\d{4}年\\d{1,2}月\\d{1,2}日[^<]*<\\/${E}>`, 'g'), '');
  // 先頭が「読了時間」
  body = body.replace(new RegExp(`<${E}[^>]*>\\s*読了時間[^<]*<\\/${E}>`, 'g'), '');
  // 先頭が「閲覧数」
  body = body.replace(new RegExp(`<${E}[^>]*>\\s*閲覧数[^<]*<\\/${E}>`, 'g'), '');
  // 先頭が「(数字)件のコメント」
  body = body.replace(new RegExp(`<${E}[^>]*>\\s*\\d*\\s*件のコメント[^<]*<\\/${E}>`, 'g'), '');
  // 先頭が「(数字)いいね！」
  body = body.replace(new RegExp(`<${E}[^>]*>\\s*\\d*\\s*いいね！[^<]*<\\/${E}>`, 'g'), '');
  // 先頭が「更新日：」
  body = body.replace(new RegExp(`<${E}[^>]*>\\s*更新日[：:][^<]*<\\/${E}>`, 'g'), '');

  // Remove standalone numeric elements (view count, like count numbers like 551, 0)
  body = body.replace(new RegExp(`<${E}[^>]*>\\s*\\d{1,7}\\s*<\\/${E}>`, 'g'), '');

  // Clean up empty <ul> / <ol> left over
  body = body.replace(/<(?:ul|ol)[^>]*>\s*<\/(?:ul|ol)>/g, '');

  return body;
}

// --- CSS for article body, headings, and TOC ---
const articleCss = `<style>
html { scroll-behavior: smooth; }
.cms-body {
  font-size: 15px;
  line-height: 1.85;
  color: #333;
}
/* ── TOC Box ── */
.toc-box {
  background: #F0F9FF;
  border: 1px solid #BAE6FD;
  border-radius: 10px;
  padding: 20px 24px 20px 36px;
  margin: 0 0 2.2em;
  display: inline-block;
  min-width: 220px;
  max-width: 100%;
}
.toc-box li {
  margin-bottom: 8px;
  color: #1a1a1a;
  list-style: disc;
  padding-left: 0;
  position: static;
}
.toc-box li::before { content: none; }
.toc-box a {
  color: #2563EB !important;
  text-decoration: none !important;
  font-size: 14px;
  line-height: 1.6;
}
.toc-box a:hover {
  text-decoration: underline !important;
  opacity: 1 !important;
}
.toc-box .toc-box {
  margin: 6px 0 0;
  padding: 0 0 0 20px;
  border: none;
  background: transparent;
  border-radius: 0;
}
/* ── Headings ── */
.cms-body h2 {
  background: #EFF6FF;
  padding: 11px 18px 11px 14px;
  border-left: 5px solid #60A5FA;
  border-radius: 0 6px 6px 0;
  font-size: 24px;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.4;
  margin: 2.4em 0 1em;
  scroll-margin-top: 100px;
}
.cms-body h3 {
  border-top: 3px solid #60A5FA;
  border-bottom: 1px solid #BFDBFE;
  padding: 10px 4px;
  font-size: 20px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.5;
  margin: 2em 0 1em;
  scroll-margin-top: 100px;
}
.cms-body h4 {
  font-size: 17px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 1.6em 0 0.6em;
  scroll-margin-top: 100px;
}
/* ── Body text ── */
.cms-body p { margin-bottom: 1em; }
.cms-body ol { margin: 1em 0; padding-left: 1.6em; list-style: decimal outside; }
.cms-body ol li { margin-bottom: 0.5em; line-height: 1.75; list-style: decimal outside; padding-left: 0.2em; }
.cms-body ul { margin: 1em 0; padding-left: 0.4em; }
.cms-body ul > li { list-style: none; padding-left: 1.5em; position: relative; margin-bottom: 0.6em; line-height: 1.75; }
.cms-body ul > li::before { content: "▶"; color: #60A5FA; position: absolute; left: 0; font-size: 0.68em; top: 0.42em; }
.cms-body a { color: #2563EB; text-decoration: underline; }
.cms-body a:hover { opacity: 0.75; }
.cms-body img { max-width: 100%; height: auto; margin: 1em 0; border-radius: 8px; }
.cms-body figure { margin: 2em 0; text-align: center; }
.cms-body figure img { margin: 0; box-shadow: 0 4px 16px rgba(0,0,0,0.10); border-radius: 12px; }
.cms-body figcaption { margin-top: 8px; font-size: 13px; color: #6B7280; }
.cms-body table { border-collapse: collapse; width: 100%; margin: 1.5em 0; table-layout: auto; }
.cms-body th { background: #DBEAFE; color: #1E40AF; font-weight: 700; text-align: center; padding: 10px 14px; border: 1px solid #93C5FD; white-space: nowrap; }
.cms-body td { border: 1px solid #DBEAFE; padding: 9px 13px; text-align: center; vertical-align: middle; }

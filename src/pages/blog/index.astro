---
import blogIndexHtml from '../../../templates/blog/index.html?raw';
import { client, escapeHtml, cached, mapBlog, type Blog } from '../../lib/microcms';
import { injectGtm } from '../../lib/gtm';
import { fullSidebar, SIDEBAR_STYLE, LIST_FILTER_JS, type CategoryCount } from '../../lib/blogSidebar';
import { renderCards, categoryTabs, resultsHeading, searchEmptyState, EMPTY_STATE_CSS, catName } from '../../lib/blogList';

const DEFINED_ORDER = ['運用の基本', 'SNS戦略', '集客', '検索対策', '活用事例', '最新情報'];

const blogs = await cached<Blog[]>('blogs-list', async () => {
  const res = await client.getList<any>({
    endpoint: 'blogs',
    queries: { limit: 100, orders: '-publishedAt', fields: 'id,title,day,publishedAt,eyecatch,category' },
  });
  return res.contents.map(mapBlog);
}).catch(() => [] as Blog[]);

const sorted = [...blogs].sort((a, b) => {
  const da = a.day ?? a.publishedAt;
  const db = b.day ?? b.publishedAt;
  return db.localeCompare(da);
});

// カテゴリー一覧（件数つき）
const catsInUse = new Set<string>();
sorted.forEach(b => { const c = catName(b); if (c) catsInUse.add(c); });
const sortedCats = [
  ...DEFINED_ORDER.filter(c => catsInUse.has(c)),
  ...[...catsInUse].filter(c => !DEFINED_ORDER.includes(c)),
];
const categories: CategoryCount[] = sortedCats.map(name => ({
  name,
  count: sorted.filter(b => catName(b) === name).length,
}));

// ── 検索（microCMS q 全文検索）＋ カテゴリー絞り込み（併用可） ──
const url = Astro.url;
const q = (url.searchParams.get('q') ?? '').trim();
const category = (url.searchParams.get('category') ?? '').trim();
const searchMode = !!(q || category);

let displayBlogs = sorted;
if (q) {
  const res = await client.getList<any>({
    endpoint: 'blogs',
    queries: { q, limit: 100, orders: '-publishedAt', fields: 'id,title,day,publishedAt,eyecatch,category' },
  }).catch(() => null);
  displayBlogs = res ? res.contents.map(mapBlog) : [];
}
if (category) displayBlogs = displayBlogs.filter(b => catName(b) === category);

let html = blogIndexHtml;

// ── カテゴリータブ（/blog はクライアント側フィルタ） ──
const TAB_START = '<div class="lg:hidden relative">';
const TAB_END_MARKER = 'rounded-r-[40px] ">集客</button></div>';
const tsi = html.indexOf(TAB_START);
const tei = html.indexOf(TAB_END_MARKER);
if (tsi !== -1 && tei !== -1) {
  const { desktop, mobile } = categoryTabs(sortedCats, 'filter', category);
  html = html.slice(0, tsi) + mobile + desktop + html.slice(tei + TAB_END_MARKER.length);
}

// ── 記事グリッド：グリッド開始〜セクション終了までを再構築 ──
const SPLIT = '<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-6 mt-10 lg:mt-16">';
const si = html.indexOf(SPLIT);
if (si !== -1) {
  const secClose = html.indexOf('</section>', si);
  const region = html.slice(si, secClose); // 旧グリッド〜もっと見るボタン
  const mbStart = region.indexOf('<div class="flex justify-center mt-16">');
  const moreBtn = !searchMode && mbStart !== -1 ? region.slice(mbStart) : '';

  const gridBody = (searchMode && displayBlogs.length === 0)
    ? searchEmptyState(q || category)
    : '<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-6 mt-4 lg:mt-6">' + renderCards(displayBlogs) + '</div>';

  const inner =
    '<div class="cm-blog-layout"><div class="cm-blog-main">' +
      (searchMode ? resultsHeading({ q, category, count: displayBlogs.length }) : '') +
      gridBody +
      moreBtn +
    '</div>' + fullSidebar(categories) + '</div>';

  html = html.slice(0, si) + inner + html.slice(secClose);
}

// ── JS / CSS / canonical / GTM ──
const filterJs = `(function(){
var cards=document.querySelectorAll('.blog-card');
var tabs=document.querySelectorAll('button.cat-tab');
var mBtn=document.getElementById('mobile-cat-btn');
var mDrop=document.getElementById('mobile-cat-dropdown');
var mLabel=document.getElementById('mobile-cat-label');
var mTabs=document.querySelectorAll('button.mobile-cat-tab');
function filter(cat){
  cards.forEach(function(c){c.style.display=(cat==='all'||c.dataset.category===cat)?'':'none';});
  tabs.forEach(function(t){
    var a=t.dataset.cat===cat;
    t.style.background=a?'#005bea':'';
    t.style.color=a?'#fff':'';
  });
  if(mLabel)mLabel.textContent=cat==='all'?'すべて':cat;
}
tabs.forEach(function(t){t.addEventListener('click',function(){filter(this.dataset.cat);});});
if(mBtn&&mDrop){
  mBtn.addEventListener('click',function(e){e.stopPropagation();mDrop.classList.toggle('hidden');});
  mTabs.forEach(function(t){t.addEventListener('click',function(){filter(this.dataset.cat);mDrop.classList.add('hidden');});});
  document.addEventListener('click',function(){mDrop.classList.add('hidden');});
}
})();`;
// モバイルは記事10件まで表示し、11件目以降は「もっと見る」で表示
// テンプレート側の既存ボタンを使う。PCは全件表示のため非表示にする
const moreMobileCss = '<style>'
  + '@media(max-width:1023px){.cm-hidden-mobile{display:none!important;}}'
  + '.cm-more-wrap{display:none!important;}'
  + '@media(max-width:1023px){.cm-more-wrap{display:flex!important;}}'
  + '.cm-more-wrap.cm-more-done{display:none!important;}'
  + '</style>';
const moreMobileJs = "(function(){var main=document.querySelector('.cm-blog-main');var grid=main&&main.querySelector('.grid');if(!grid)return;var link=null,as=main.querySelectorAll('a[href=\"#\"]');for(var i=0;i<as.length;i++){if(as[i].textContent.indexOf('もっと見る')>=0){link=as[i];break;}}if(!link)return;var wrap=link.parentNode;var cards=grid.querySelectorAll('.blog-card');if(cards.length<=10){wrap.style.display='none';return;}wrap.classList.add('cm-more-wrap');for(var j=10;j<cards.length;j++)cards[j].classList.add('cm-hidden-mobile');link.addEventListener('click',function(e){e.preventDefault();grid.querySelectorAll('.cm-hidden-mobile').forEach(function(c){c.classList.remove('cm-hidden-mobile');});wrap.classList.add('cm-more-done');});})();";

html = html.replace('</body>', `<script>${filterJs}</script><script>${LIST_FILTER_JS}</script><script>${moreMobileJs}</script></body>`);

const blogIndexUrl = 'https://www.cocomarke.com/blog/';
const blogCanonical = `<link rel="canonical" href="${blogIndexUrl}"><meta property="og:url" content="${blogIndexUrl}">`;
html = html.replace(/<link rel="canonical"[^>]*>/i, '');
// 検索/絞り込み結果は重複回避のため noindex（カテゴリーは専用ページ /blog/category/ をインデックス）
const robots = searchMode ? '<meta name="robots" content="noindex,follow">' : '';
html = html.replace('</head>', blogCanonical + robots + SIDEBAR_STYLE + EMPTY_STATE_CSS + moreMobileCss + '</head>');
html = injectGtm(html);

return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
---

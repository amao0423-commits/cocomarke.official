---
import indexHtml from '../../templates/index.html?raw';
import { client, formatDate, escapeHtml, cached, mapFaq, mapNews, mapBlog, type Faq, type News, type Blog } from '../lib/microcms';
import { injectGtm } from '../lib/gtm';

const [faqs, newsItems, topBlogs] = await Promise.all([
  cached<Faq[]>('faq', async () => {
    const res = await client.getList<any>({ endpoint: 'faq', queries: { limit: 100 } });
    return res.contents.map(mapFaq);
  }).catch(() => [] as Faq[]),
  cached<News[]>('news', async () => {
    const res = await client.getList<any>({ endpoint: 'news', queries: { limit: 100, orders: '-day' } });
    return res.contents.map(mapNews);
  }).catch(() => [] as News[]),
  cached<Blog[]>('blogs-list', async () => {
    const res = await client.getList<any>({ endpoint: 'blogs', queries: { limit: 100, orders: '-publishedAt', fields: 'id,title,day,publishedAt,eyecatch,category' } });
    return res.contents.map(mapBlog);
  }).catch(() => [] as Blog[]),
]);

let html = indexHtml;

// --- お知らせ置き換え（6件/ページ・ドットナビ付き）---
if (newsItems.length > 0) {
  const SPLIT = 'お知らせ</h2></div><div class="flex flex-col">';
  const si = html.indexOf(SPLIT);
  if (si !== -1) {
    const pre = html.slice(0, si + SPLIT.length);
    const rest = html.slice(si + SPLIT.length);
    const faqIdx = rest.indexOf('<div id="faq"');
    const closing = rest.slice(0, faqIdx).slice(rest.slice(0, faqIdx).lastIndexOf('</div></section>'));

    const PAGE_SIZE = 6;
    const pages: News[][] = [];
    for (let i = 0; i < newsItems.length; i += PAGE_SIZE) {
      pages.push(newsItems.slice(i, i + PAGE_SIZE));
    }

    const buildRows = (page: News[], pageIdx: number) =>
      page.map((item, i) =>
        '<a class="flex flex-col lg:flex-row gap-2 lg:gap-6 items-start py-6 border-b border-[#8d8d8d] hover:opacity-70 transition-opacity ' + (i === 0 ? 'border-t' : '') + '" href="/news/' + item.id + '/">' +
        '<time class="text-base text-[#005BEA] font-normal leading-[30px] tracking-[0.03em] whitespace-nowrap">' + formatDate(item.day ?? item.publishedAt) + '</time>' +
        '<p class="flex-1 text-base leading-[30px] tracking-[0.03em] text-[#333]">' + escapeHtml(item.title) + '</p>' +
        '</a>'
      ).join('');

    const pagesHtml = pages.map((page, pi) =>
      '<div class="news-page" data-page="' + pi + '"' + (pi > 0 ? ' style="display:none"' : '') + '>' +
      buildRows(page, pi) +
      '</div>'
    ).join('');

    const dotsHtml = pages.length > 1
      ? '<div class="flex justify-center gap-3 mt-6">' +
        pages.map((_, i) =>
          '<button class="news-dot w-2.5 h-2.5 rounded-full transition-colors duration-200 ' +
          (i === 0 ? 'bg-[#005bea]' : 'bg-[#ccc]') +
          '" data-target="' + i + '" aria-label="' + (i + 1) + 'ページ目"></button>'
        ).join('') +
        '</div>'
      : '';

    const newsMoreLink = '<div class="flex justify-center mt-10"><a class="inline-flex items-center justify-center h-[50px] px-12 min-w-[220px] rounded-full bg-gradient-to-r from-[#00c6fb] to-[#0965f6] text-white text-base font-semibold hover:opacity-90 transition-opacity" href="/news/">お知らせ一覧を見る</a></div>';
    html = pre + pagesHtml + dotsHtml + newsMoreLink + closing + rest.slice(faqIdx);
  }
}

// --- FAQ 置き換え ---
if (faqs.length > 0) {
  const SPLIT = 'よくある質問</h2></div><div class="space-y-4">';
  const si = html.indexOf(SPLIT);
  if (si !== -1) {
    const pre = html.slice(0, si + SPLIT.length);
    const rest = html.slice(si + SPLIT.length);
    const ci = rest.indexOf('</div></section></div>');
    const plusSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="faq-icon w-5 h-5 text-primary shrink-0 transition-transform duration-200"><path d="M5 12h14"></path><path class="faq-v" d="M12 5v14"></path></svg>';
    const newFaqs = faqs.map(item =>
      '<div class="bg-white rounded-2xl overflow-hidden">' +
      '<button class="w-full flex items-center justify-between p-5 lg:p-6 text-left cursor-pointer" aria-expanded="false">' +
      '<div class="flex items-center gap-3">' +
      '<span class="w-6 h-6 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center shrink-0">Q</span>' +
      '<span class="text-base font-semibold leading-[29px] lg:leading-[30px]">' + escapeHtml(item.question) + '</span>' +
      '</div>' + plusSvg + '</button>' +
      '<div class="hidden px-5 pb-5 lg:px-6 lg:pb-6 text-sm lg:text-base leading-relaxed text-gray-700">' + item.answer + '</div></div>'
    ).join('');
    html = pre + newFaqs + rest.slice(ci);
  }
}

// --- お役立ち情報（トップページブログ3件）置き換え ---
if (topBlogs.length > 0) {
  const BLOG_SPLIT = '<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-6 mb-10 lg:mb-16">';
  const BLOG_AFTER = '</div><div class="flex justify-center">';
  const bsi = html.indexOf(BLOG_SPLIT);
  if (bsi !== -1) {
    const brest = html.slice(bsi + BLOG_SPLIT.length);
    const bai = brest.indexOf(BLOG_AFTER);
    if (bai !== -1) {
      // day フィールド優先で降順ソート → 常に最新3件
      const latest3 = [...topBlogs].sort((a, b) => {
        const da = a.day ?? a.publishedAt;
        const db = b.day ?? b.publishedAt;
        return db.localeCompare(da);
      }).slice(0, 3);
      const newBlogCards = latest3.map(blog => {
        const bDate = formatDate(blog.day ?? blog.publishedAt);
        const bCat  = typeof blog.category === 'string' ? blog.category : blog.category?.name ?? '';
        const bImg  = blog.eyecatch?.url ?? '/images/blog-01.jpg';
        return (
          '<a class="block hover:opacity-90 transition-opacity" href="/blog/' + blog.id + '/">' +
          '<div class="flex flex-col shadow-[0px_0px_24px_0px_rgba(128,170,218,0.3)] rounded-[10px] lg:rounded-[20px] overflow-hidden bg-white">' +
          '<div class="relative w-full aspect-[384/200]">' +
          '<img alt="' + escapeHtml(blog.title) + '" loading="lazy" class="object-cover" src="' + bImg + '" style="position:absolute;height:100%;width:100%;inset:0;object-fit:cover;"></div>' +
          '<div class="bg-white p-3 lg:p-6 flex flex-col gap-1 lg:gap-2">' +
          '<div class="flex flex-col lg:flex-row gap-1 lg:gap-2 items-start">' +
          '<span class="text-xs lg:text-base font-black leading-[1.5] text-black">' + bDate + '</span>' +
          (bCat ? '<span class="text-xs text-[#005bea] border border-[#005bea] rounded-[10px] px-3 py-[2px] leading-[1.4] whitespace-nowrap">' + escapeHtml(bCat) + '</span>' : '') +
          '</div>' +
          '<p class="text-xs lg:text-lg font-extrabold leading-[1.6] tracking-[0.03em] text-[#005bea] line-clamp-2">' + escapeHtml(blog.title) + '</p>' +
          '</div></div></a>'
        );
      }).join('');
      html = html.slice(0, bsi) + BLOG_SPLIT + newBlogCards + BLOG_AFTER + brest.slice(bai + BLOG_AFTER.length);
    }
  }
}

// --- FAQ accordion + お知らせページネーション JS ---
const scriptOpen = ['<', 's', 'c', 'r', 'i', 'p', 't', '>'].join('');
const scriptClose = ['<', '/', 's', 'c', 'r', 'i', 'p', 't', '>'].join('');
const accordionFn = "document.querySelectorAll('#faq button[aria-expanded]').forEach(function(b){b.addEventListener('click',function(){var p=this.nextElementSibling,o=this.getAttribute('aria-expanded')==='true';this.setAttribute('aria-expanded',String(!o));p.classList.toggle('hidden');var v=this.querySelector('.faq-v');if(v)v.style.display=o?'':'none';});});";
const newsPaginationFn = "(function(){var pages=document.querySelectorAll('.news-page'),dots=document.querySelectorAll('.news-dot');if(!pages.length||!dots.length)return;function show(n){pages.forEach(function(p,i){p.style.display=i===n?'block':'none';});dots.forEach(function(d,i){d.style.background=i===n?'#005bea':'#ccc';});}dots.forEach(function(d){d.addEventListener('click',function(){show(parseInt(this.dataset.target));});});})();";
const ctaSection = '<section class="relative"><div class="absolute inset-0"><img alt="" loading="lazy" decoding="async" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;" src="/images/cta-background-02.jpg"><div class="absolute inset-0 bg-[rgba(56,56,56,0.75)] mix-blend-multiply"></div></div><div class="relative lg:max-w-[1200px] mx-auto px-4 lg:px-5 py-20"><h2 class="text-[26px] lg:text-[32px] font-semibold leading-[38px] lg:leading-[45px] text-white text-center">投稿制作から拡散まで、成果を生むInstagram運用</h2><p class="mt-6 text-base leading-[29px] lg:leading-[30px] tracking-[0.54px] text-white text-center">Instagram運用を「なんとなく」から「成果設計型」へ。まずはお気軽にご相談ください。</p><div class="flex flex-col lg:flex-row gap-6 mt-12"><div class="flex-1 bg-white rounded-[20px] py-5 lg:py-10 flex flex-col items-center gap-4 lg:gap-6"><h3 class="text-xl lg:text-[24px] font-semibold leading-[30px] lg:leading-[36px] bg-gradient-to-b from-[#0965f6] to-[#00c6fb] bg-clip-text text-transparent text-center">会社概要</h3><p class="text-base lg:text-lg leading-[29px] lg:leading-[30px] tracking-[0.54px] text-black text-center px-5">当社の事業内容や会社情報について<br>ご紹介しています。</p><a class="flex items-center justify-between w-[300px] lg:w-[350px] px-4 py-3 lg:px-6 lg:py-4 rounded-[40px] bg-gradient-to-r from-[#00c6fb] to-[#0965f6] text-white font-medium text-base leading-[1.6] tracking-[0.48px]" href="/about/"><span class="flex-1 text-center">企業情報を見る</span><span class="flex items-center justify-center w-6 h-6 lg:w-8 lg:h-8 rounded-full bg-white shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#0062e0]"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div><div class="flex-1 bg-white rounded-[20px] py-5 lg:py-10 flex flex-col items-center gap-4 lg:gap-6"><h3 class="text-xl lg:text-[24px] font-semibold leading-[30px] lg:leading-[36px] bg-gradient-to-b from-[#0965f6] to-[#00c6fb] bg-clip-text text-transparent text-center">お問い合わせ</h3><p class="text-base lg:text-lg leading-[1.6] tracking-[0.54px] text-black text-center px-5">サービスに関するご相談やご質問など、<br>お気軽にお問い合わせください。</p><a class="flex items-center justify-between w-[300px] lg:w-[350px] px-4 py-3 lg:px-6 lg:py-4 rounded-[40px] bg-gradient-to-r from-[#00c6fb] to-[#0965f6] text-white font-medium text-base leading-[1.6] tracking-[0.48px]" href="/contact/"><span class="flex-1 text-center">お問い合わせ</span><span class="flex items-center justify-center w-6 h-6 lg:w-8 lg:h-8 rounded-full bg-white shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#0062e0]"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div></div></div></section>';
html = html.replace('</main>', ctaSection + '</main>');
html = html.replace('</body>', scriptOpen + accordionFn + newsPaginationFn + scriptClose + '</body>');
html = injectGtm(html);

return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
---

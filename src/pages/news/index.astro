---
import shellHtml from '../../../templates/contact/thanks/index.html?raw';
import { client, cached, escapeHtml, formatDate, mapNews, type News } from '../../lib/microcms';
import { injectGtm } from '../../lib/gtm';

const newsItems = await cached<News[]>('news', async () => {
  const res = await client.getList<any>({
    endpoint: 'news',
    queries: { limit: 100, orders: '-day' },
  });
  return res.contents.map(mapNews);
}).catch(() => [] as News[]);

let html = shellHtml;
const pageUrl = 'https://www.cocomarke.com/news/';
const title = 'お知らせ | COCOマーケ';
const description = 'COCOマーケからのお知らせ一覧です。最新情報や更新情報をご確認いただけます。';
const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.cocomarke.com/' },
    { '@type': 'ListItem', position: 2, name: 'お知らせ', item: pageUrl },
  ],
});

const rows = newsItems.length
  ? newsItems.map(item =>
      '<a class="flex flex-col lg:flex-row gap-2 lg:gap-8 py-6 border-b border-[#d8e3f0] hover:opacity-70 transition-opacity" href="/news/' + item.id + '/">' +
      '<time class="text-sm lg:text-base text-[#005bea] font-semibold leading-[1.7] whitespace-nowrap">' + formatDate(item.day ?? item.publishedAt) + '</time>' +
      '<div class="flex-1">' +
      '<h2 class="text-base lg:text-lg font-semibold leading-[1.8] text-[#041840]">' + escapeHtml(item.title) + '</h2>' +
      '</div>' +
      '</a>'
    ).join('')
  : '<p class="text-base leading-[1.8] text-[#333]">現在、掲載中のお知らせはありません。</p>';

const main = '<main class="flex-1">' +
  '<div class="bg-white pt-20 lg:pt-[100px]">' +
  '<div class="lg:max-w-[1200px] mx-auto px-4 lg:px-5 py-4">' +
  '<nav class="news-index-breadcrumb mb-8"><ol class="flex flex-wrap items-center gap-2 text-xs text-[#333] leading-[1.4]">' +
  '<li><a class="font-medium hover:opacity-70 transition-opacity" href="/">トップページ</a></li>' +
  '<li>/</li><li>お知らせ</li>' +
  '</ol></nav>' +
  '<section class="py-8 lg:py-16">' +
  '<h1 class="text-[28px] lg:text-[34px] font-semibold leading-[1.45] bg-gradient-to-b from-[#0965f6] to-[#00c6fb] bg-clip-text text-transparent">お知らせ</h1>' +
  '<p class="mt-4 text-sm lg:text-base leading-[1.8] text-[#333]">COCOマーケからの最新情報をお届けします。</p>' +
  '<div class="mt-10 border-t border-[#d8e3f0]">' + rows + '</div>' +
  '</section>' +
  '</div>' +
  '</div>' +
  '</main>';

html = html.replace(/<title>.*?<\/title>/, '<title>' + title + '</title>');
html = html.replace(/<meta name="description" content="[^"]*">/, '<meta name="description" content="' + description + '">');
html = html.replace(/<meta name="robots" content="noindex,nofollow">/i, '');
html = html.replace(/<link rel="canonical"[^>]*>/i, '<link rel="canonical" href="' + pageUrl + '">');
html = html.replace(/<meta property="og:url" content="[^"]*">/i, '<meta property="og:url" content="' + pageUrl + '">');
html = html.replace(/<meta property="og:title" content="[^"]*">/i, '<meta property="og:title" content="' + title + '">');
html = html.replace(/<meta property="og:description" content="[^"]*">/i, '<meta property="og:description" content="' + description + '">');
html = html.replace(/<meta name="twitter:title" content="[^"]*">/i, '<meta name="twitter:title" content="' + title + '">');
html = html.replace(/<meta name="twitter:description" content="[^"]*">/i, '<meta name="twitter:description" content="' + description + '">');
html = html.replace(/<script type="application\/ld\+json">[\s\S]*?<\/script>/i, '<script type="application/ld+json">' + breadcrumbSchema + '</script>');
html = html.replace('</head>', '<style>@media(max-width:768px){.news-index-breadcrumb{margin-bottom:24px}.news-index-breadcrumb ol{font-size:11px;line-height:1.6}.news-index-breadcrumb li{min-width:0}}</style></head>');
html = html.replace(/<main class="flex-1">[\s\S]*?<\/main>/, main);
html = injectGtm(html);

return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
---
